package in.ac.mitmeerut.clearance.controller;

import in.ac.mitmeerut.clearance.entity.Student;
import in.ac.mitmeerut.clearance.entity.User;
import in.ac.mitmeerut.clearance.enums.Role;
import in.ac.mitmeerut.clearance.service.StudentService;
import in.ac.mitmeerut.clearance.service.UserService;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;

@Controller
public class PageController {

    private final UserService userService;
    private final StudentService studentService;

    public PageController(
            UserService userService,
            StudentService studentService) {

        this.userService = userService;
        this.studentService = studentService;
    }

    // Open login page
    @GetMapping("/login")
    public String loginPage() {
        return "login";
    }

    // Process login form
    @PostMapping("/login")
    public String login(
            @RequestParam String email,
            @RequestParam String password,
            Model model) {

        try {

            // Find user by email
            User user = userService.getUserByEmail(email);

            // Check password
            if (user.getPassword() == null ||
                    !user.getPassword().equals(password)) {

                model.addAttribute(
                        "error",
                        "Invalid email or password."
                );

                return "login";
            }

            // Check student role
            if (user.getRole() == Role.STUDENT) {

                // Find the student using logged-in user's ID
                Student student =
                        studentService.getStudentByUserId(user.getId());

                // Redirect using actual student ID
                return "redirect:/student-dashboard?studentId="
                        + student.getId();
            }

            // Staff login
            if (user.getRole() == Role.STAFF) {
                return "redirect:/staff-dashboard";
            }

            // Admin login
            if (user.getRole() == Role.ADMIN) {
                return "redirect:/admin-dashboard";
            }

            model.addAttribute("error", "Invalid user role.");

            return "login";

        } catch (RuntimeException exception) {

            model.addAttribute(
                    "error",
                    "Invalid email or password."
            );

            return "login";
        }
    }

    // Display student dashboard
    @GetMapping("/student-dashboard")
    public String studentDashboard(
            @RequestParam Long studentId,
            Model model) {

        // Find the correct student
        Student student =
                studentService.getStudentById(studentId);

        // Send student details to HTML
        model.addAttribute("student", student);

        return "student-dashboard";
    }

    // Staff dashboard
    @GetMapping("/staff-dashboard")
    public String staffDashboard() {
        return "staff-dashboard";
    }

    // Admin dashboard
    @GetMapping("/admin-dashboard")
    public String adminDashboard() {
        return "admin-dashboard";
    }
}
