package in.ac.mitmeerut.clearance.service;

import in.ac.mitmeerut.clearance.entity.Student;
import in.ac.mitmeerut.clearance.exception.StudentNotFoundException;
import in.ac.mitmeerut.clearance.repository.StudentRepository;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class StudentService {

    private final StudentRepository studentRepository;

    public StudentService(StudentRepository studentRepository) {
        this.studentRepository = studentRepository;
    }

    // Create Student
    public Student saveStudent(Student student) {
        return studentRepository.save(student);
    }

    // Get all Students
    public List<Student> getAllStudents() {
        return studentRepository.findAll();
    }

    // Get Student by ID
    public Student getStudentById(Long userId) {

        return studentRepository.findById(userId)
                .orElseThrow(() ->
                        new StudentNotFoundException(
                                "Student not found with user id: " + userId
                        )
                );
    }

    // Update Student
    public Student updateStudent(Long userId, Student student) {

        Student existingStudent = studentRepository.findById(userId)
                .orElseThrow(() ->
                        new StudentNotFoundException(
                                "Student not found with user id: " + userId
                        )
                );

        existingStudent.setRollNumber(student.getRollNumber());
        existingStudent.setCourse(student.getCourse());
        existingStudent.setBranch(student.getBranch());
        existingStudent.setSemester(student.getSemester());

        return studentRepository.save(existingStudent);
    }

    // Delete Student
    public void deleteStudent(Long userId) {

        Student existingStudent = studentRepository.findById(userId)
                .orElseThrow(() ->
                        new StudentNotFoundException(
                                "Student not found with user id: " + userId
                        )
                );

        studentRepository.delete(existingStudent);
    }
}